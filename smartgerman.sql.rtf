CREATE TABLE public.community_posts (\
  id uuid NOT NULL DEFAULT gen_random_uuid(),\
  user_id uuid NOT NULL,\
  title text NOT NULL,\
  content text NOT NULL,\
  category text CHECK (category = ANY (ARRAY['kurswunsch'::text, 'feedback'::text, 'frage'::text, 'diskussion'::text])),\
  upvotes integer DEFAULT 0,\
  downvotes integer DEFAULT 0,\
  score integer DEFAULT (upvotes - downvotes),\
  is_active boolean DEFAULT true,\
  created_at timestamp with time zone DEFAULT now(),\
  updated_at timestamp with time zone DEFAULT now(),\
  CONSTRAINT community_posts_pkey PRIMARY KEY (id),\
  CONSTRAINT community_posts_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.users(id)\
);\
CREATE TABLE public.course_monthly_schedules (\
  id uuid NOT NULL DEFAULT gen_random_uuid(),\
  course_id uuid NOT NULL,\
  month_start date NOT NULL,\
  month_end date NOT NULL,\
  units_count integer NOT NULL,\
  price_per_unit numeric NOT NULL,\
  total_price numeric NOT NULL,\
  description text,\
  is_active boolean DEFAULT true,\
  created_at timestamp with time zone DEFAULT now(),\
  updated_at timestamp with time zone DEFAULT now(),\
  is_manual_override boolean DEFAULT false,\
  weekdays ARRAY,\
  start_time time without time zone,\
  end_time time without time zone,\
  unit_duration_minutes integer,\
  units_per_slot integer NOT NULL DEFAULT 1,\
  CONSTRAINT course_monthly_schedules_pkey PRIMARY KEY (id),\
  CONSTRAINT course_monthly_schedules_course_id_fkey FOREIGN KEY (course_id) REFERENCES public.courses(id)\
);\
CREATE TABLE public.courses (\
  id uuid NOT NULL DEFAULT gen_random_uuid(),\
  name text NOT NULL,\
  level text NOT NULL CHECK (level = ANY (ARRAY['A1'::text, 'A2'::text, 'B1'::text, 'B2'::text, 'C1'::text, 'C2'::text])),\
  format text NOT NULL CHECK (format = ANY (ARRAY['Standard'::text, 'Intensiv'::text, 'Einzelunterricht'::text, 'Online'::text, 'Wochenende'::text, 'Abend'::text])),\
  description text,\
  duration_weeks integer NOT NULL,\
  max_participants integer DEFAULT 8,\
  current_participants integer DEFAULT 0,\
  is_active boolean DEFAULT true,\
  created_at timestamp with time zone DEFAULT now(),\
  updated_at timestamp with time zone DEFAULT now(),\
  price_per_unit numeric DEFAULT 10.00,\
  unit_duration_minutes integer NOT NULL DEFAULT 45,\
  CONSTRAINT courses_pkey PRIMARY KEY (id)\
);\
CREATE TABLE public.email_logs (\
  id uuid NOT NULL DEFAULT gen_random_uuid(),\
  user_id uuid,\
  registration_id uuid,\
  email_type text NOT NULL CHECK (email_type = ANY (ARRAY['registration_confirmation'::text, 'invoice'::text, 'reminder'::text, 'newsletter'::text, 'course_info'::text, 'payment_confirmation'::text, 'waitlist_confirmation'::text])),\
  recipient_email text NOT NULL,\
  subject text NOT NULL,\
  status text NOT NULL DEFAULT 'pending'::text CHECK (status = ANY (ARRAY['pending'::text, 'sent'::text, 'failed'::text])),\
  sent_at timestamp with time zone,\
  error_message text,\
  metadata jsonb,\
  created_at timestamp with time zone DEFAULT now(),\
  CONSTRAINT email_logs_pkey PRIMARY KEY (id)\
);\
CREATE TABLE public.enrollments (\
  id uuid NOT NULL DEFAULT gen_random_uuid(),\
  user_id uuid NOT NULL,\
  course_id uuid NOT NULL,\
  registration_id uuid,\
  enrollment_date timestamp with time zone DEFAULT now(),\
  status text NOT NULL DEFAULT 'active'::text CHECK (status = ANY (ARRAY['active'::text, 'completed'::text, 'cancelled'::text, 'paused'::text, 'pending'::text])),\
  completion_date timestamp with time zone,\
  certificate_issued boolean DEFAULT false,\
  certificate_issued_at timestamp with time zone,\
  created_at timestamp with time zone DEFAULT now(),\
  updated_at timestamp with time zone DEFAULT now(),\
  CONSTRAINT enrollments_pkey PRIMARY KEY (id),\
  CONSTRAINT enrollments_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.users(id),\
  CONSTRAINT enrollments_course_id_fkey FOREIGN KEY (course_id) REFERENCES public.courses(id),\
  CONSTRAINT enrollments_registration_id_fkey FOREIGN KEY (registration_id) REFERENCES public.registrations(id)\
);\
CREATE TABLE public.registrations (\
  id uuid NOT NULL DEFAULT gen_random_uuid(),\
  user_id uuid NOT NULL,\
  course_id uuid NOT NULL,\
  language_level text CHECK (language_level = ANY (ARRAY['keine_kenntnisse'::text, 'grundkenntnisse'::text, 'unsicher'::text])),\
  additional_info text,\
  phone text,\
  consent boolean NOT NULL DEFAULT false,\
  status text NOT NULL DEFAULT 'pending'::text CHECK (status = ANY (ARRAY['pending'::text, 'confirmed'::text, 'rejected'::text, 'cancelled'::text, 'waitlist'::text])),\
  confirmation_sent boolean DEFAULT false,\
  confirmation_sent_at timestamp with time zone,\
  processed_by uuid,\
  processed_at timestamp with time zone,\
  notes text,\
  created_at timestamp with time zone DEFAULT now(),\
  updated_at timestamp with time zone DEFAULT now(),\
  CONSTRAINT registrations_pkey PRIMARY KEY (id),\
  CONSTRAINT registrations_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.users(id),\
  CONSTRAINT registrations_course_id_fkey FOREIGN KEY (course_id) REFERENCES public.courses(id),\
  CONSTRAINT registrations_processed_by_fkey FOREIGN KEY (processed_by) REFERENCES public.users(id)\
);\
CREATE TABLE public.user_sessions (\
  id uuid NOT NULL DEFAULT gen_random_uuid(),\
  user_id uuid NOT NULL,\
  token text NOT NULL UNIQUE,\
  expires_at timestamp with time zone NOT NULL,\
  user_agent text,\
  ip_address text,\
  created_at timestamp with time zone DEFAULT now(),\
  CONSTRAINT user_sessions_pkey PRIMARY KEY (id),\
  CONSTRAINT user_sessions_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.users(id)\
);\
CREATE TABLE public.users (\
  id uuid NOT NULL DEFAULT gen_random_uuid(),\
  first_name text NOT NULL,\
  last_name text NOT NULL,\
  email text NOT NULL UNIQUE,\
  phone text,\
  address text,\
  city text,\
  zip_code text,\
  country text DEFAULT 'Deutschland'::text,\
  language_preference text DEFAULT 'de'::text,\
  membership_status text DEFAULT 'inactive'::text CHECK (membership_status = ANY (ARRAY['active'::text, 'inactive'::text, 'paused'::text])),\
  membership_expiry timestamp with time zone,\
  created_at timestamp with time zone DEFAULT now(),\
  updated_at timestamp with time zone DEFAULT now(),\
  CONSTRAINT users_pkey PRIMARY KEY (id)\
);\
CREATE TABLE public.waitlist (\
  id uuid NOT NULL DEFAULT gen_random_uuid(),\
  user_id uuid NOT NULL,\
  course_id uuid NOT NULL,\
  position integer,\
  status text DEFAULT 'waiting'::text CHECK (status = ANY (ARRAY['waiting'::text, 'notified'::text, 'enrolled'::text, 'cancelled'::text])),\
  created_at timestamp with time zone DEFAULT now(),\
  updated_at timestamp with time zone DEFAULT now(),\
  registration_id uuid,\
  CONSTRAINT waitlist_pkey PRIMARY KEY (id),\
  CONSTRAINT waitlist_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.users(id),\
  CONSTRAINT waitlist_course_id_fkey FOREIGN KEY (course_id) REFERENCES public.courses(id),\
  CONSTRAINT waitlist_registration_id_fkey FOREIGN KEY (registration_id) REFERENCES public.registrations(id)\
);}